# Database Configuration for Prisma
DATABASE_URL="postgresql://batch_refinement_user:your_secure_password@localhost:5432/batch_refinement?schema=public"

# Required environment variables
DLP_PRIVATE_KEY=your_private_key_here
DLP_ADDRESS=your_address_here
DATA_REGISTRY_ADDRESS=your_registry_address_here
RPC_URL=your_rpc_url_here
REFINEMENT_SERVICE_API_BASE_URL=your_refinement_service_url_here

# API Configuration
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here
ADMIN_API_KEY=your_admin_api_key_here
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# API keys for Pinata (if using)
PINATA_API_JWT=your_pinata_api_jwt

# Optional environment variables with default values
BATCH_SIZE=10
REFINER_ID=7
VERBOSE=false

# Node environment
NODE_ENV=development

# Logging configuration
LOG_LEVEL=info
LOG_DIR=logs
